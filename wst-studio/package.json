{
  "name": "wst-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/studio.mjs --log-level=warning",
    "studio": "npm run build --silent && node dist/studio.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"
  }
}
